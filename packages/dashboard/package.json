{
  "name": "@signet/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Signet approver dashboard",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@signet/circuit": "workspace:*",
    "@signet/cli": "workspace:*",
    "@signet/contracts": "workspace:*",
    "@signet/extension": "workspace:*",
    "gsap": "3.12.5",
