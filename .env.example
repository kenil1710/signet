# Names only. Copy to .env (git-ignored) and fill in locally. Never commit real values.

# X Layer (mainnet chain id 196). Public endpoints, not secrets. Two independent operators (OKX, dRPC):
# Guard and watchtower require them to agree. Foundry reads XLAYER_RPC_URL as the `xlayer` endpoint.
XLAYER_RPC_URL=https://xlayerrpc.okx.com
XLAYER_RPC_URL_2=https://xlayer.drpc.org
XLAYER_CHAIN_ID=196

# Deployer key for contracts (dev account only)
DEPLOYER_PRIVATE_KEY=

# CI proposer key: can only propose releases (GitHub secret in real projects)
SIGNET_PROPOSER_KEY=

# TapeOut addresses (fill from docs/tapeout-interfaces.md after the spikes)
TAPEOUT_PROCESSOR_ADDRESS=
TAPEOUT_CIRCUIT_ID=
TAPEOUT_SITE_REGISTRY_ADDRESS=

# Watchtower alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TAPESEND_SENDER_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
