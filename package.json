{
  "name": "signet",
  "private": true,
  "description": "Signet: sealed releases and signing-time allowlists for dApp frontends on X Layer (TapeOut).",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "env:link": "ln -sf ../../.env packages/contracts/.env",
    "staging:up": "staging/up.sh",
    "staging:down": "staging/down.sh",
    "staging:time": "staging/time.sh",
    "staging:fund": "staging/fund.sh",
    "staging:smoke": "staging/smoke.sh",
    "staging:renew": "staging/renew-operator.sh",
    "staging:demo": "staging/demo-cli.sh",
    "signet": "node packages/cli/src/cli.ts",
    "attacks": "pnpm --filter @signet/attacks attacks",
    "staging:guard-tapeout": "staging/guard-tapeout.sh",
    "staging:rehearse-mainnet": "staging/rehearse-mainnet.sh",
    "verify:claims": "node packages/claims/src/verify.ts",
    "try:setup": "node staging/try-it.mjs setup",
    "try:serve": "node staging/try-it.mjs serve",
    "try:hack": "node staging/try-it.mjs hack",
    "try:clean": "node staging/try-it.mjs clean",
    "try:build": "node staging/try-it.mjs build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
